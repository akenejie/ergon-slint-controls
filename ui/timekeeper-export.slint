// じかん君 (サンプル アプリ) の「CSV を書き出す」ダイアログ。
//
// フォーム本体 (TimeKeeperExportForm) はオーバーレイ表示面
// (timekeeper.slint の ModalPopupHost + ModalDialogHost) と子ウィンドウ
// (TimeKeeperExport) の両方から使う。値 (comma / header / bom) と確定 /
// キャンセル (ok / cancel) は呼び出し側がプロパティ / コールバックでつなぐ。
// 表示方式の判断・二重オープン ガード・モーダル化は modal_dialog が担う。

import { SmallButton, ModeToggleButton, CosmicCheckBox, TooltipPopup } from "@ergon_slint_controls";

// 書き出しオプションのフォーム本体 (表示方式で共有)。
export component TimeKeeperExportForm {
	// 値 (書き出しのたびに Rust から読まれる)。
	in-out property <bool> comma: true;    // 区切り (true=カンマ, false=タブ)
	in-out property <bool> header: true;   // ヘッダー行
	in-out property <bool> bom: false;     // BOM 付き (Excel 向け)

	callback ok();
	callback cancel();

	VerticalLayout {
		spacing: 10px;

		HorizontalLayout {
			spacing: 6px;
			Text { text: "区切り:"; vertical-alignment: center; }
			ModeToggleButton {
				text: "カンマ";
				tooltip-text: "カンマで区切ります。";
				checked: root.comma;
				clicked => { root.comma = true; }
			}
			ModeToggleButton {
				text: "タブ";
				tooltip-text: "タブで区切ります。";
				checked: !root.comma;
				clicked => { root.comma = false; }
			}
		}

		HorizontalLayout {
			spacing: 6px;
			// 項目ごとのチェックボックス。クリック領域は TouchArea で補外する。
			Rectangle {
				width: 16px;
				height: 16px;
				CosmicCheckBox { checked: root.header; }
				TouchArea { clicked => { root.header = !root.header; } }
			}
			Text { text: "ヘッダー行"; vertical-alignment: center; font-size: 0.9rem; }
			Rectangle {
				width: 16px;
				height: 16px;
				CosmicCheckBox { checked: root.bom; }
				TouchArea { clicked => { root.bom = !root.bom; } }
			}
			Text { text: "BOM 付き (Excel 向け)"; vertical-alignment: center; font-size: 0.9rem; }
		}

		Rectangle { vertical-stretch: 1; }

		HorizontalLayout {
			spacing: 8px;
			Rectangle { horizontal-stretch: 1; }
			SmallButton {
				text: "書き出す";
				primary: true;
				tooltip-text: "CSV に書き出します。";
				clicked => { root.ok(); }
			}
			SmallButton {
				text: "キャンセル";
				tooltip-text: "ダイアログを閉じます。";
				clicked => { root.cancel(); }
			}
		}
	}
}

// 子ウィンドウ方式の「CSV を書き出す」ダイアログ。examples/timekeeper.rs が
// ModalController::open の make_child で生成する。表示・Esc/Enter の読み替え・
// 中央配置・破棄は modal_dialog が担う。
export component TimeKeeperExport inherits Window {
	title: "CSV を書き出す";
	preferred-width: 320px;
	preferred-height: 180px;

	// Linux でライブラリがデスクトップ環境の UI フォントを流し込めるように
	// する宣言 (必須バイディング。timekeeper.slint のコメント参照)。
	in property <string> ui-font-family: "";
	default-font-family: root.ui-font-family;

	// 値 (書き出しのたびに Rust が読み書きする)。
	in-out property <bool> comma: true;    // 区切り (true=カンマ, false=タブ)
	in-out property <bool> header: true;   // ヘッダー行
	in-out property <bool> bom: false;     // BOM 付き (Excel 向け)

	callback ok();
	callback cancel();

	TimeKeeperExportForm {
		comma <=> root.comma;
		header <=> root.header;
		bom <=> root.bom;
		ok => { root.ok(); }
		cancel => { root.cancel(); }
	}

	// ---- コントロールのツールチップ (カーソル追従) ----
	// ダイアログのウィンドウにしたルートの末尾に置く (from_library のグローバ
	// ルはウィンドウごとの実体なので、メイン ウィンドウのものとは分かれる)。
	TooltipPopup { }
}
