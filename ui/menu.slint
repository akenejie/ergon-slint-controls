//
// Fluent-styled menu bar controls, adapted from
// i-slint-compiler widgets/fluent/menu.slint so that they can be embedded in
// the window (rather than shown as native / runtime-managed menus) and so that
// the currently highlighted item can be reported back to the application for
// the bottom status line.
//
// Only the light color-scheme values are used here, matching the rest of the
// application's fixed colors.

import { MenuBarItemBase, MenuBarBase, MenuFrameBase, MenuItemBase, MenuHintHub, MenuOpenHub, MenuAccessKey } from "menu-base.slint";

// メニュー バーの構造登録 (MenuBarMenu / MenuKeyControl) はファイル末尾
// (MenuItemView の宣言の後) で定義する。slint は前方参照で型を解決しない
// ため。

// メニューバー / メニューのテーマ色。既定は Windows 10 標準風の固定値。
// アプリが `@ergon_slint_controls` で部品を参照すると、このグローバルは
// from_library として共有される (型はライブラリの生成コード、実体はアプリの
// ルート コンポーネントごと)。実体はライブラリが生成する
// ergon_slint_controlsSharedGlobals の生成時にライブラリへ通知されるため、
// ライブラリ内部で流し込みができる。Linux では platform::setup_window が
// GTK テーマから取得した色 (Chromium ui/gtk と同じ方式) を流し込む。アプリ
// 側のコードは不要。Windows / macOS は流し込みを行わないので既定値のまま
// (見た目不変)。
export global MenuBarTheme {
	// メニューバー (バー本体)。
	in-out property <color> bar-background: #FFFFFF;
	// バー下端の下線。
	in-out property <color> bar-underline: #E5E5E5;
	// バー下端の下線の太さ。テーマがバーに固有の背景色を与える (白以外の)
	// 環境では 0px にして下線を消し、バー全体をそのぶん小さくする。
	in-out property <length> bar-underline-height: 2px;
	// バー項目の文字色。
	in-out property <color> bar-foreground: #000000E6;
	// ドロップダウン メニュー。
	in-out property <color> menu-background: #FAFAFA;
	// ドロップダウン項目の文字色。
	in-out property <color> menu-foreground: #000000E6;
	// 項目のハイライト (hover / キーボード選択) 背景。
	in-out property <color> menu-hover-background: #0000000A;
	// 暗色テーマか (hover などの半透明オーバーレイの白黒反転用)。
	in-out property <bool> dark: false;
}

/// Top-level menu bar button. Exposes the hover state and a description that
/// the application shows in its bottom status line. The description is also
/// reported to `MenuHintHub` while the button is hovered.
export component FluentMenuBarItem {
	in property <MenuEntry> entry;
	in property <string> description;
	// Alt 押下中はタイトルのアクセスキー文字 (&X) に下線を引く。
	in property <bool> access-key-underline: false;
	// このボタンのメニューを開いている間は背景色を付ける。
	in property <bool> menu-open: false;
	callback clicked;
	callback hovered;

	out property <string> hover-description: base.has-hover ? root.description : "";

	// hover の変化を MenuHintHub へ報告する (説明の出力先は呼び出し側が選ぶ)。
	// 離したときのクリアは「自分が最後に報告した説明がまだ表示中のときだけ」
	// 行う (隣の項目へ hover が移った場合、移動先の報告を消さないため)。
	property <bool> reported-hover: base.has-hover;
	changed reported-hover => {
		if (self.reported-hover) {
			MenuHintHub.bar-text = root.description;
		} else if (MenuHintHub.bar-text == root.description) {
			MenuHintHub.bar-text = "";
		}
	}

	min-width: base.min-width;
	min-height: base.min-height;

	base := MenuBarItemBase {
		entry: root.entry;
		access-key-underline: root.access-key-underline;
		menu-open: root.menu-open;
		font-size: 1.0909rem;
		horizontal-padding: 8px;
		top-padding: 0px;
		bottom-padding: 2px + MenuBarTheme.bar-underline-height;
		default-foreground: MenuBarTheme.bar-foreground;
		hover-foreground: MenuBarTheme.bar-foreground;
		// 押下中は文字を少し沈める (背景との間を取る)。
		pressed-foreground: MenuBarTheme.bar-foreground.mix(MenuBarTheme.bar-background, 0.4);
		// hover / 押下 / 開き中の背景は半透明オーバーレイ。暗色テーマでは白ベ
		// ースに反転する (黒のオーバーレイは暗い背景の上で見えないため)。
		hover-background: MenuBarTheme.dark ? #FFFFFF0A : #0000000A;
		pressed-background: MenuBarTheme.dark ? #FFFFFF0F : #0000000F;
		open-background: MenuBarTheme.dark ? #FFFFFF14 : #00000014;
		border-radius: 3px;

		clicked => { root.clicked(); }
		hovered => { root.hovered(); }
	}
}

export component FluentMenuBar inherits MenuBarBase {
	spacing: 2px;
	min-layout-height: 21px;
	// Windows 10 標準風は白。Linux ではテーマに馴染ませる (MenuBarTheme)。
	background: MenuBarTheme.bar-background;
}

/// Copied from the bar part of `MenuBarImpl` in
/// i-slint-compiler widgets/common/menus.slint. The upstream component also
/// owns the `ContextMenuInternal` dropdown; here the dropdown is rendered by
/// the application as a normal in-window overlay (see main.slint) so that the
/// hovered entry stays observable. `@children` lets the application provide
/// its (static) `FluentMenuBarItem`s.
export component FluentMenuBarImpl {
	preferred-width: 100%;
	height: base.min-height;

	base := FluentMenuBar {
		width: 100%;
		@children
	}

	// Windows 10 標準風: 下端の下線。バーの上に重ねて描く (TouchArea ではな
	// いのでクリックは下のメニューボタンへ通る)。太さは MenuBarTheme.bar-
	// underline-height (テーマ適用環境では 0px = 描かれない)。
	Rectangle {
		x: 0;
		y: root.height - MenuBarTheme.bar-underline-height;
		width: 100%;
		height: MenuBarTheme.bar-underline-height;
		background: MenuBarTheme.bar-underline;
	}
}

/// ドロップダウン項目 1 行分のデータ。`entry` が項目本体 (有効状態と
/// "&X" アクセスキー記法を含むタイトルの唯一の情報源)、`shortcut-text` は
/// 見た目の調整。行番号はモデルの index。
export struct MenuItemView {
	entry: MenuEntry,
	// 右側に表示するショートカット表記 (例 "Ctrl+Z", 省略時は entry.shortcut)。
	shortcut-text: string,
}

/// A single dropdown entry. `is-current` is driven by the parent (from the
/// base's set-current/clear-current callbacks); `activated` is fired when the
/// user picks the entry.
export component FluentMenuItem {
	in property <MenuEntry> entry <=> base.entry;
	in property <bool> is-current <=> base.is-current;
	// Alt 押下中はタイトルのアクセスキー文字 (&X) に下線を引く。
	in property <bool> access-key-underline: false;
	// 項目の右側に出すショートカット表記 (例 "Ctrl+Z")。
	in property <string> shortcut-text: "";

	callback set-current <=> base.set-current;
	callback clear-current <=> base.clear-current;
	callback activated;

	min-height: entry.is-separator ? 7px : max(22px, base.min-height);
	max-height: entry.is-separator ? 7px : base.max-height;

	HorizontalLayout {
		padding: entry.is-separator ? 3px : 1px;
		padding-left: entry.is-separator ? 0px : 1px;
		padding-right: entry.is-separator ? 0px : 1px;

		base := MenuItemBase {
			access-key-underline: root.access-key-underline;
			shortcut-text: root.shortcut-text;
			default-foreground: MenuBarTheme.menu-foreground;
			// 押下中 / 無効相当の字色は文字と背景の中間。
			alternate-foreground: MenuBarTheme.menu-foreground.mix(MenuBarTheme.menu-background, 0.4);
			current-foreground: MenuBarTheme.menu-foreground;
			current-background: MenuBarTheme.menu-hover-background;
			separator-color: MenuBarTheme.menu-foreground.mix(MenuBarTheme.menu-background, 0.15);
			border-radius: 2px;
			font-size: 1.0909rem;
			horizontal-padding: 8px;
			spacing: 6px;
			icon-size: 12px;

			activate(e, y) => { root.activated(); }
		}
	}
}

/// ドロップダウン。項目リスト (`items`) を描画する。行番号はモデルの index で、
/// 無効行 / 区切り行を含む。現在ハイライト中の行は `current-row`。
///
/// - 無効行 / 区切り行はクリックを吸収するだけで反応しない
///   (ポップアップも閉じない)
/// - マウス hover は有効行のみハイライトする
/// - 有効行が選択されると `activated(row)` を発火する
///
/// キーボードの上下移動 (無効行のスキップ) は呼び出し側が `items` モデルを
/// 読んで `current-row` を更新する (有効状態の真実はこのモデル)。
export component FluentMenuFrame inherits MenuFrameBase {
	background: MenuBarTheme.menu-background;
	border-radius: 3px;
	border-width: 1px;
	border-color: MenuBarTheme.menu-foreground.mix(MenuBarTheme.menu-background, 0.15);
	drop-shadow-color: #00000020;
	drop-shadow-offset-y: 4px;
	drop-shadow-blur: 8px;
	margin: 3px;
	layout-min-width: 160px;

	in property <[MenuItemView]> items;
	// 現在ハイライト中の行 (呼び出し側のキー操作と共有するため in-out)。
	in-out property <int> current-row: -1;
	// 行ごとの説明。hover / キーボード選択中の行のものが MenuHintHub へ報告
	// される (空 = 説明なし)。
	in property <[string]> descriptions;
	// 項目の下線文字 (Alt 押下中表示)。全項目共通。
	in property <bool> access-key-underline: false;
	// 有効行が選択された (row はモデル index)。
	callback activated(int);

	// 現在の行の説明を MenuHintHub へ報告する。
	function report-hint() {
		MenuHintHub.frame-text = self.visible
			&& root.current-row >= 0 && root.current-row < descriptions.length
			? descriptions[root.current-row] : "";
	}
	changed current-row => { report-hint(); }
	changed visible => { report-hint(); }

	for it[i] in root.items : FluentMenuItem {
		entry: it.entry;
		access-key-underline: root.access-key-underline;
		shortcut-text: it.shortcut-text;
		is-current: root.current-row == i;
		set-current => { root.current-row = i; }
		clear-current => { root.current-row = -1; }
		activated => { root.activated(i); }
	}
}

/// メニュー (in-window オーバーレイ) が開いている間、ポップアップの外側の
/// クリックを捕捉して閉じるレイヤ。`MenuOpenHub.open` を読んで自動で有効に
/// なり、外側の押下 (メニューバーより下。全ボタン) で `MenuOpenHub.close()`
/// を呼ぶ。メニューバーの領域は覆わないので、バー項目の hover / 開き替えは
/// 生きる。追加の後始末 (選択行のリセットなど) が必要なら dismiss を受ける。
export component MenuDismissLayer inherits Rectangle {
	// 既定では MenuOpenHub.open >= 0 で有効。自前で開閉状態を持つアプリは
	// ここを束ね替えてよい。
	in property <bool> active: MenuOpenHub.open >= 0;
	// 覆う領域の上端 (メニューバーの高さ。バーは塞がない)。
	in property <length> top: 0px;
	// 閉じたときの追加処理 (省略可)。
	callback dismiss();

	x: 0;
	y: 0;
	width: 100%;
	height: 100%;
	visible: root.active;

	TouchArea {
		x: 0;
		y: root.top;
		width: 100%;
		height: parent.height - root.top;
		pointer-event(e) => {
			if (e.kind == PointerEventKind.down) {
				MenuOpenHub.close();
				root.dismiss();
			}
		}
	}
}

/// メニュー項目の説明を出す左下ポップアップ。ウィンドウのルートに置くと、
/// hover / キーボード選択中の項目の説明が左下に浮かぶ (ステータスバーのない
/// アプリ向け。ステータスバーのあるアプリは MenuHintHub.text を自分の
/// ステータス行に束ねる)。ウィンドウ全体を覆う透明レイヤとして実装してある
/// ため、他の要素を覆い隠さないようウィンドウのルートの最後に置くこと
/// (レイヤ自体は TouchArea を持たないのでクリックは下へ通る)。
export component MenuHintPopup inherits Rectangle {
	x: 0;
	y: 0;
	width: 100%;
	height: 100%;
	visible: MenuHintHub.text != "";

	Rectangle {
		x: 3px;
		y: parent.height - self.height - 3px;
		width: hint.preferred-width + 8px;
		height: hint.preferred-height + 4px;
		background: MenuBarTheme.menu-background;
		border-color: MenuBarTheme.menu-foreground.mix(MenuBarTheme.menu-background, 0.25);
		border-width: 0.5px;
		border-radius: 3px;
		drop-shadow-color: #00000033;
		drop-shadow-offset-y: 1px;
		drop-shadow-blur: 2px;

		hint := Text {
			x: 4px;
			y: 2px;
			width: self.preferred-width;
			height: self.preferred-height;
			text: MenuHintHub.text;
			font-size: 1rem;
			color: MenuBarTheme.menu-foreground;
			vertical-alignment: center;
		}
	}
}

// メニュー バーの構造登録。アプリはバー項目の並び (title は "&X" アクセスキー
// 記法) と items (ドロップダウンへ渡すのと同じモデル) をこのグローバルへ束ね、
// activate ハンドラに「項目が押されたときの処理」を登録する。UI 描画はライ
// ブラリの部品 (FluentMenuBar*) が担い、キーボード操作の判定 (Alt+文字での
// 開閉 / アクセスキー発火 / 上下左右 / Enter / Esc) はライブラリの
// menu::handle_menu_key (Rust) がこの登録を読んで担う。アプリ側は項目と処理
// だけを持ち、OS 分岐やキー判定のコードは持たない。
export struct MenuBarMenu {
	// バー項目のタイトル ("&X" 記法)。X が Alt+X のアクセスキー。
	title: string,
	// ドロップダウンへ渡すのと同じ項目モデル (MenuItemView)。
	items: [MenuItemView],
}

export global MenuKeyControl {
	// バー項目の並び (アプリが登録する)。**スナップショット**: 登録は式の
	// 評価時の値で固定されるため、項目モデルが差し替わる (enabled の依存が
	// 変わる) たびに再登録が必要。アプリは init と、モデルを替えるプロパ
	// ティの changed ハンドラから再登録すること (再登録しないとキー操作が
	// 古い enabled のままになる — 実測)。
	in-out property <[MenuBarMenu]> menus: [];

	// 項目がキー操作で発火された (アプリがハンドラを登録する)。
	// menu = バー項目の index、row = 項目モデルの行 index。
	callback activate(int, int);

	// ラベル (Label / AccessKeyHub 対応) のアクセスキー一覧 (アプリが登録す
	// る。MenuAccessKey.parse(タイトル).key の形)。メニューが閉じている間
	// に押された文字をここで照合し、一致すれば AccessKeyHub.press でラベル
	// へ通知する (ラベルの access-key-pressed が発火する)。menus と同じく
	// スナップショットのため、依存が変わったら再登録する。
	in-out property <[string]> label-keys: [];

	// ボタンのアクセスキー一覧 (アプリが登録する)。メニューが閉じている間
	// に押された文字をここで照合し、一致すれば action(index) を発火する。
	in-out property <[string]> action-keys: [];

	// アクセスキー付きボタンがキー操作で発火された (アプリがハンドラを登録
	// する)。index = action-keys の行。
	callback action(int);
}
