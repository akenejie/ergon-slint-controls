//
// Fluent-styled menu bar controls, adapted from
// i-slint-compiler widgets/fluent/menu.slint so that they can be embedded in
// the window (rather than shown as native / runtime-managed menus) and so that
// the currently highlighted item can be reported back to the application for
// the bottom status line.
//
// Only the light color-scheme values are used here, matching the rest of the
// application's fixed colors.

import { MenuBarItemBase, MenuBarBase, MenuFrameBase, MenuItemBase, MenuHintHub } from "menu-base.slint";

/// Top-level menu bar button. Exposes the hover state and a description that
/// the application shows in its bottom status line. The description is also
/// reported to `MenuHintHub` while the button is hovered.
export component FluentMenuBarItem {
	in property <MenuEntry> entry;
	in property <string> description;
	// Alt 押下中はタイトルのアクセスキー文字 (&X) に下線を引く。
	in property <bool> access-key-underline: false;
	// このボタンのメニューを開いている間は背景色を付ける。
	in property <bool> menu-open: false;
	callback clicked;
	callback hovered;

	out property <string> hover-description: base.has-hover ? root.description : "";

	// hover の変化を MenuHintHub へ報告する (説明の出力先は呼び出し側が選ぶ)。
	property <bool> reported-hover: base.has-hover;
	changed reported-hover => {
		MenuHintHub.bar-text = self.reported-hover ? root.description : "";
	}

	min-width: base.min-width;
	min-height: base.min-height;

	base := MenuBarItemBase {
		entry: root.entry;
		access-key-underline: root.access-key-underline;
		menu-open: root.menu-open;
		font-size: 1.0909rem;
		horizontal-padding: 8px;
		top-padding: 0px;
		bottom-padding: 4px;
		default-foreground: #000000E6;
		hover-foreground: #000000E6;
		pressed-foreground: #00000099;
		hover-background: #0000000A;
		pressed-background: #0000000F;
		open-background: #00000014;
		border-radius: 3px;

		clicked => { root.clicked(); }
		hovered => { root.hovered(); }
	}
}

export component FluentMenuBar inherits MenuBarBase {
	spacing: 2px;
	min-layout-height: 21px;
	// Windows 10 標準風: 背景は白 (下端の灰色下線は FluentMenuBarImpl 側)。
	background: #FFFFFF;
}

/// Copied from the bar part of `MenuBarImpl` in
/// i-slint-compiler widgets/common/menus.slint. The upstream component also
/// owns the `ContextMenuInternal` dropdown; here the dropdown is rendered by
/// the application as a normal in-window overlay (see main.slint) so that the
/// hovered entry stays observable. `@children` lets the application provide
/// its (static) `FluentMenuBarItem`s.
export component FluentMenuBarImpl {
	preferred-width: 100%;
	height: base.min-height;

	base := FluentMenuBar {
		width: 100%;
		@children
	}

	// Windows 10 標準風: 下端 2px の灰色下線。バーの上に重ねて描く
	// (TouchArea ではないのでクリックは下のメニューボタンへ通る)。
	Rectangle {
		x: 0;
		y: root.height - 2px;
		width: 100%;
		height: 2px;
		background: #E5E5E5;
	}
}

/// ドロップダウン項目 1 行分のデータ。`entry` が項目本体 (有効状態と
/// "&X" アクセスキー記法を含むタイトルの唯一の情報源)、`shortcut-text` は
/// 見た目の調整。行番号はモデルの index。
export struct MenuItemView {
	entry: MenuEntry,
	// 右側に表示するショートカット表記 (例 "Ctrl+Z", 省略時は entry.shortcut)。
	shortcut-text: string,
}

/// A single dropdown entry. `is-current` is driven by the parent (from the
/// base's set-current/clear-current callbacks); `activated` is fired when the
/// user picks the entry.
export component FluentMenuItem {
	in property <MenuEntry> entry <=> base.entry;
	in property <bool> is-current <=> base.is-current;
	// Alt 押下中はタイトルのアクセスキー文字 (&X) に下線を引く。
	in property <bool> access-key-underline: false;
	// 項目の右側に出すショートカット表記 (例 "Ctrl+Z")。
	in property <string> shortcut-text: "";

	callback set-current <=> base.set-current;
	callback clear-current <=> base.clear-current;
	callback activated;

	min-height: entry.is-separator ? 7px : max(22px, base.min-height);
	max-height: entry.is-separator ? 7px : base.max-height;

	HorizontalLayout {
		padding: entry.is-separator ? 3px : 1px;
		padding-left: entry.is-separator ? 0px : 1px;
		padding-right: entry.is-separator ? 0px : 1px;

		base := MenuItemBase {
			access-key-underline: root.access-key-underline;
			shortcut-text: root.shortcut-text;
			default-foreground: #000000E6;
			alternate-foreground: #00000099;
			current-foreground: #000000E6;
			current-background: #0000000A;
			separator-color: #00000026;
			border-radius: 2px;
			font-size: 1.0909rem;
			horizontal-padding: 8px;
			spacing: 6px;
			icon-size: 12px;

			activate(e, y) => { root.activated(); }
		}
	}
}

/// ドロップダウン。項目リスト (`items`) を描画する。行番号はモデルの index で、
/// 無効行 / 区切り行を含む。現在ハイライト中の行は `current-row`。
///
/// - 無効行 / 区切り行はクリックを吸収するだけで反応しない
///   (ポップアップも閉じない)
/// - マウス hover は有効行のみハイライトする
/// - 有効行が選択されると `activated(row)` を発火する
///
/// キーボードの上下移動 (無効行のスキップ) は呼び出し側が `items` モデルを
/// 読んで `current-row` を更新する (有効状態の真実はこのモデル)。
export component FluentMenuFrame inherits MenuFrameBase {
	background: #FAFAFA;
	border-radius: 3px;
	border-width: 1px;
	border-color: #00000026;
	drop-shadow-color: #00000020;
	drop-shadow-offset-y: 4px;
	drop-shadow-blur: 8px;
	margin: 3px;
	layout-min-width: 160px;

	in property <[MenuItemView]> items;
	// 現在ハイライト中の行 (呼び出し側のキー操作と共有するため in-out)。
	in-out property <int> current-row: -1;
	// 行ごとの説明。hover / キーボード選択中の行のものが MenuHintHub へ報告
	// される (空 = 説明なし)。
	in property <[string]> descriptions;
	// 項目の下線文字 (Alt 押下中表示)。全項目共通。
	in property <bool> access-key-underline: false;
	// 有効行が選択された (row はモデル index)。
	callback activated(int);

	// 現在の行の説明を MenuHintHub へ報告する。
	function report-hint() {
		MenuHintHub.frame-text = self.visible
			&& root.current-row >= 0 && root.current-row < descriptions.length
			? descriptions[root.current-row] : "";
	}
	changed current-row => { report-hint(); }
	changed visible => { report-hint(); }

	for it[i] in root.items : FluentMenuItem {
		entry: it.entry;
		access-key-underline: root.access-key-underline;
		shortcut-text: it.shortcut-text;
		is-current: root.current-row == i;
		set-current => { root.current-row = i; }
		clear-current => { root.current-row = -1; }
		activated => { root.activated(i); }
	}
}

/// メニュー項目の説明を出す左下ポップアップ。ウィンドウのルートに置くと、
/// hover / キーボード選択中の項目の説明が左下に浮かぶ (ステータスバーのない
/// アプリ向け。ステータスバーのあるアプリは MenuHintHub.text を自分の
/// ステータス行に束ねる)。ウィンドウ全体を覆う透明レイヤとして実装してある
/// ため、他の要素を覆い隠さないようウィンドウのルートの最後に置くこと
/// (レイヤ自体は TouchArea を持たないのでクリックは下へ通る)。
export component MenuHintPopup inherits Rectangle {
	x: 0;
	y: 0;
	width: 100%;
	height: 100%;
	visible: MenuHintHub.text != "";

	Rectangle {
		x: 3px;
		y: parent.height - self.height - 3px;
		width: hint.preferred-width + 8px;
		height: hint.preferred-height + 4px;
		background: #ffffff;
		border-color: #00000040;
		border-width: 0.5px;
		border-radius: 3px;
		drop-shadow-color: #00000033;
		drop-shadow-offset-y: 1px;
		drop-shadow-blur: 2px;

		hint := Text {
			x: 4px;
			y: 2px;
			width: self.preferred-width;
			height: self.preferred-height;
			text: MenuHintHub.text;
			font-size: 1rem;
			color: #202020;
			vertical-alignment: center;
		}
	}
}
