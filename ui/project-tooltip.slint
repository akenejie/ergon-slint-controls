// Project-local tooltip (shared). Tweak border-radius/background/border/shadow here.
export component AppTooltip inherits Rectangle {
	in property <string> text;
	in property <length> padding-h: 8px;
	in property <length> padding-v: 2px;

	background: #ffffff;
	border-radius: 3px;
	border-width: 0.5px;
	border-color: #00000040;
	drop-shadow-color: #00000033;
	drop-shadow-offset-y: 1px;
	drop-shadow-blur: 2px;

	VerticalLayout {
		padding-left: padding-h;
		padding-right: padding-h;
		padding-top: padding-v;
		padding-bottom: padding-v;

		Text {
			text: root.text;
			color: #202020;
			font-size: 1rem;
			vertical-alignment: center;
		}
	}
}
