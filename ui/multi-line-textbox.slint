// MultiLineTextBox (複数行テキスト入力)
// slint 標準 (fluent) の textedit.slint + common/textedit-base.slint をアプリ
// 内に移植したもの (TextBox と同じ方式)。スクロールは同様に移植した
// ScrollView (scrollview.slint) を使う。FluentPalette の依存を外すため、
// ライト配色の値をローカルに焼いている。
//
// 標準からの変更点: パディング (scroll-view-padding) を 12px から 8px にして
// TextBox (左右 8px) と揃えた。配色は TextBox と同じライト固定。
// ライブラリ側 (i-slint-compiler/widgets/*) は変更しない。

import { ScrollView } from "scrollview.slint";

export component MultiLineTextBoxBase inherits Rectangle {
	in property <length> scroll-view-padding;

	in property <TextWrap> wrap <=> text-input.wrap;
	in property <TextHorizontalAlignment> horizontal-alignment <=> text-input.horizontal-alignment;
	in property <InputMethodHints> input-method-hints <=> text-input.input-method-hints;
	in property <bool> read-only <=> text-input.read-only;
	in property <length> font-size <=> text-input.font-size;
	in property <string> font-family <=> text-input.font-family;
	in property <bool> font-italic <=> text-input.font-italic;
	in property <bool> enabled <=> text-input.enabled;
	out property <bool> has-focus: text-input.has-focus;
	out property <length> visible-width <=> scroll-view.visible-width;
	out property <length> visible-height <=> scroll-view.visible-height;
	in-out property <string> text <=> text-input.text;
	in-out property <length> content-x <=> scroll-view.content-x;
	in-out property <length> content-y <=> scroll-view.content-y;
	in-out property <length> content-width <=> scroll-view.content-width;
	in-out property <length> content-height <=> scroll-view.content-height;

	// 文字色 (Rectangle の組み込み color と衝突するため foreground で公開)。
	in property <brush> foreground <=> text-input.color;
	in property <int> font-weight <=> text-input.font-weight;
	in property <brush> selection-background-color;
	in property <brush> selection-foreground-color;

	in property <string> placeholder-text;
	in property <brush> placeholder-color;

	callback edited(text: string);
	callback key-pressed(event: KeyEvent) -> EventResult;
	callback key-released(event: KeyEvent) -> EventResult;

	// 上級者向け: 内部 TextInput の直API。
	public function set-selection-offsets(anchor: int, focus: int) {
		text-input.set-selection-offsets(anchor, focus);
	}
	public function select-all() { text-input.select-all(); }
	public function clear-selection() { text-input.clear-selection(); }
	public function cut() { text-input.cut(); }
	public function copy() { text-input.copy(); }
	public function paste() { text-input.paste(); }

	forward-focus: text-input;

	ContextMenuArea {
		enabled: root.enabled;
		Menu {
			MenuItem {
				title: "Cut";
				enabled: !root.read-only && root.enabled;
				activated => { text-input.cut(); }
			}

			MenuItem {
				title: "Copy";
				enabled: !root.text.is-empty;
				activated => { text-input.copy(); }
			}

			MenuItem {
				enabled: !root.read-only && root.enabled;
				title: "Paste";
				activated => { text-input.paste(); }
			}

			MenuItem {
				title: "Select All";
				enabled: !root.text.is-empty;
				activated => { text-input.select-all(); }
			}
		}

		scroll-view := ScrollView {
			x: root.scroll-view-padding;
			y: root.scroll-view-padding;
			width: parent.width - 2 * root.scroll-view-padding;
			height: parent.height - 2 * root.scroll-view-padding;
			content-width: root.wrap == TextWrap.no-wrap ? max(self.visible-width, text-input.preferred-width) : self.visible-width;
			content-height: max(self.visible-height, text-input.preferred-height);

			text-input := TextInput {
				enabled: true;
				single-line: false;
				wrap: word-wrap;
				selection-background-color: root.selection-background-color;
				selection-foreground-color: root.selection-foreground-color;
				page-height: scroll-view.visible-height;
				// アクセシビリティは外側のコンポーネントが面倒を見る。
				accessible-role: none;

				edited => {
					root.edited(self.text);
				}

				key-pressed(event) => {
					root.key-pressed(event)
				}

				key-released(event) => {
					root.key-released(event)
				}

				cursor-position-changed(cpos) => {
					if (cpos.x + root.content-x < 0px) {
						root.content-x = min(0px, max(parent.visible-width - self.width, -cpos.x));
					} else if (cpos.x + root.content-x > parent.visible-width) {
						root.content-x = min(0px, max(parent.visible-width - self.width, parent.visible-width - cpos.x));
					}

					if (cpos.y + root.content-y < 0px) {
						root.content-y = min(
							0px,

							// This prevents jumping back and forth between this case and the
							// else if on each cursor movement. This means that if the visible
							// height is less than the line height we align on the cursor bottom.
							parent.visible-height - cpos.y - 20px,

							max(parent.visible-height - self.height, -cpos.y),
						);
					} else if (cpos.y + root.content-y > parent.visible-height - 20px) {
						// FIXME: font-height hardcoded to 20px
						root.content-y = min(0px, max(parent.visible-height - self.height, parent.visible-height - cpos.y - 20px));
					}
				}
			}
		}
	}

	placeholder := Text {
		x: scroll-view.x;
		y: scroll-view.y;
		width: scroll-view.width;
		vertical-alignment: top;
		text: (root.text == "" && text-input.preedit-text == "") ? root.placeholder-text : "";
		font-size: text-input.font-size;
		font-italic: text-input.font-italic;
		font-weight: text-input.font-weight;
		font-family: text-input.font-family;
		color: root.placeholder-color;
		overflow: elide;
		accessible-role: none;
	}

	@children
}

export component MultiLineTextBox {
	in property <TextWrap> wrap <=> base.wrap;
	in property <TextHorizontalAlignment> horizontal-alignment <=> base.horizontal-alignment;
	in property <InputMethodHints> input-method-hints <=> base.input-method-hints;
	in property <bool> read-only <=> base.read-only;
	in property <length> font-size <=> base.font-size;
	in property <int> font-weight <=> base.font-weight;
	in property <brush> color <=> base.foreground;
	in property <bool> enabled <=> base.enabled;
	in property <string> placeholder-text <=> base.placeholder-text;
	// 空のときに薄く出す仮置きテキストの色 (既定 = FluentPalette.text-secondary)。
	in property <brush> placeholder-color: #00000099;
	out property <bool> has-focus: base.has-focus;
	out property <length> visible-width <=> base.visible-width;
	out property <length> visible-height <=> base.visible-height;
	in-out property <string> text <=> base.text;
	in-out property <length> content-x <=> base.content-x;
	in-out property <length> content-y <=> base.content-y;
	in-out property <length> content-width <=> base.content-width;
	in-out property <length> content-height <=> base.content-height;

	callback edited <=> base.edited;
	callback key-pressed <=> base.key-pressed;
	callback key-released <=> base.key-released;

	accessible-role: text-input;
	accessible-enabled: root.enabled;
	accessible-value <=> text;
	accessible-placeholder-text: placeholder-text;
	accessible-read-only: root.read-only;
	accessible-action-set-value(v) => { text = v; edited(v); }
	accessible-action-set-selection-offsets(anchor, focus) => { base.set-selection-offsets(anchor, focus); }

	// 上級者向け: 内部 TextInput の直API を MultiLineTextBoxBase 経由で使う。
	public function set-selection-offsets(anchor: int, focus: int) {
		base.set-selection-offsets(anchor, focus);
	}
	public function select-all() { base.select-all(); }
	public function cut() { base.cut(); }
	public function copy() { base.copy(); }
	public function paste() { base.paste(); }

	forward-focus: base;
	horizontal-stretch: 1;
	vertical-stretch: 1;

	states [
		disabled when !root.enabled: {
			base.background: #F9F9F94D;
			base.foreground: #0000005E;
			base.selection-foreground-color: #FFFFFF;
			base.placeholder-color: #0000005E;
		}
		focused when root.has-focus: {
			base.background: #FFFFFF;
			i-focus-border.background: #005FB8;
		}
	]

	base := MultiLineTextBoxBase {
		width: 100%;
		height: 100%;
		// 配色は TextBox と同じライト固定。
		background: #FFFFFFB3;
		border-radius: 4px;
		border-width: 1px;
		border-color: @linear-gradient(180deg, #0000000F 99.99%, #00000073 100%, #00000073 100%);
		// パディングは TextBox (左右 8px) と揃える。
		scroll-view-padding: 8px;
		foreground: #000000E6;
		placeholder-color: root.placeholder-color;
		selection-background-color: #0078D4;
		selection-foreground-color: #FFFFFF;

		i-focus-border := Rectangle {
			x: parent.border-radius;
			y: parent.height - self.height;
			width: parent.width - 2 * parent.border-radius;
			height: 2px;
			border-radius: 1px;
		}
	}
}
