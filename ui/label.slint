// Label
// "&" アクセスキー記法を解釈するテキストラベル。メニュー (menu-base.slint の
// AccessKeyLabel) と同じ記法を、メニュー以外 (入力欄のキャプション等) でも
// 使えるようにしたもの。
//
// タイトル中の "&X" はアクセスキー (常に下線を表示) として、"&&" はリテラルの
// & として描画する。アクセスキーはタイトルにのみ書く (別プロパティは無い)。
//
// アクセスキーが押されたらフォーカスしてほしいコントロールは、ラベルの
// activate (押下のたびに +1 されるカウンタ) をコントロールの focus-request へ
// バインドする:
//
// ```slint
// pen-width-label := Label { text: "線の太さ (&G)"; }
// pen-spin := SpinBox { focus-request: pen-width-label.activate; }
// ```
//
// アプリのキー処理は `AccessKeyHub.press(文字)` を呼ぶだけでよく、一致する
// アクセスキーを持つ Label が activate を進める。

import { AccessKeyHub, AccessKeyLabel, MenuAccessKey } from "menu-base.slint";

export component Label inherits AccessKeyLabel {
	// アクセスキーが押されるたびに +1 される (コントロールの focus-request へ
	// バインドして使う)。
	out property <int> activate: 0;

	underline: true;
	color: #000000E6;
	font-size: 1rem;

	// アクセスキーが押されたら activate を進め、ハブをクリアする (次の押下で
	// 変化が検知できるように)。
	property <bool> hit: root.text != "" && AccessKeyHub.pressed != ""
		&& AccessKeyHub.pressed.to-uppercase() == MenuAccessKey.parse(root.text).key.to-uppercase();
	changed hit => {
		if (self.hit) {
			self.activate += 1;
			AccessKeyHub.pressed = "";
		}
	}
}
