//
// Copied from i-slint-compiler widgets/common/menu-base.slint and modified:
//   - MenuBarItemBase exposes `has-hover` so the app can show a description
//     line while the pointer is over a top-level menu button.
//   - The labels take `access-key` / `access-key-underline`, showing a
//     Windows-style "(X)" whose letter is underlined while Alt is held.
//     They are built from plain `Text` elements: `StyledText` consumes mouse
//     events (for link support) and would starve the parent TouchArea of
//     hover/click.

// Windows 風のメニューラベル。タイトルの後に "(X)" を付け、Alt 押下中は
// キー文字の下に下線を引く。`Text` を並べて組むので親の TouchArea を妨げない。
component AccessKeyLabel inherits HorizontalLayout {
	in property <string> text;
	// "..." は括弧閉じの直後に置くため、タイトル側では末尾の "..." を外して
	// これを true にする (Windows のメニュー表記に合わせる)。
	in property <bool> ellipsis: false;
	in property <string> access-key: "";
	in property <bool> underline: false;
	in property <brush> color;
	in property <length> font-size;

	spacing: 0px;
	alignment: start;
	cross-axis-alignment: center;

	Text {
		text: root.text;
		color: root.color;
		font-size: root.font-size;
		vertical-alignment: center;
	}
	// アクセスキーの括弧の前には半角スペースを入れる。
	if root.access-key != "" : Text {
		text: " (";
		color: root.color;
		font-size: root.font-size;
		vertical-alignment: center;
	}
	if root.access-key != "" : Rectangle {
		min-width: key-text.preferred-width;
		preferred-width: key-text.preferred-width;
		min-height: key-text.preferred-height;
		preferred-height: key-text.preferred-height;

		key-text := Text {
			text: root.access-key;
			color: root.color;
			font-size: root.font-size;
			vertical-alignment: center;
		}

		if root.underline : Rectangle {
			x: key-text.x;
			y: key-text.y + key-text.font-metrics.ascent + 1px;
			width: key-text.width;
			height: 1px;
			background: root.color;
		}
	}
	if root.access-key != "" : Text {
		text: ")";
		color: root.color;
		font-size: root.font-size;
		vertical-alignment: center;
	}
	// 括弧閉じの直後に "..." を置く (間隔は spacing: 0px なので詰まる)。
	if root.ellipsis : Text {
		text: "...";
		color: root.color;
		font-size: root.font-size;
		vertical-alignment: center;
	}
}

export component MenuBarItemBase {
	in property <MenuEntry> entry;
	in property <brush> default-foreground;
	in property <brush> hover-foreground;
	in property <brush> pressed-foreground;
	in property <brush> default-background;
	in property <brush> hover-background;
	in property <brush> pressed-background;
	// このボタンに対応するメニューを開いている間、背景色を付けておく。
	in property <bool> menu-open: false;
	in property <brush> open-background: hover-background;
	in property <length> font-size <=> label.font-size;
	in property <length> border-radius <=> background-layer.border-radius;
	in property <length> horizontal-padding;
	in property <length> top-padding;
	in property <length> bottom-padding;
	// Modification: Windows-style access key shown as "(X)"; the letter is
	// underlined while `access-key-underline` is set (Alt held).
	in property <string> access-key: "";
	in property <bool> access-key-underline: false;

	// Modification: expose the hover state for the bottom status line.
	out property <bool> has-hover: touch-area.has-hover;

	callback clicked;
	callback hovered;

	background-layer := Rectangle {
		background: root.default-background;

		touch-area := TouchArea {
			layout := HorizontalLayout {
				padding-top: root.top-padding;
				padding-bottom: root.bottom-padding;
				padding-left: root.horizontal-padding;
				padding-right: root.horizontal-padding;

				label := AccessKeyLabel {
					text: root.entry.title;
					access-key: root.access-key;
					underline: root.access-key-underline;
					color: root.default-foreground;
				}
			}

			pointer-event(event) => {
				if event.kind == PointerEventKind.down {
					root.clicked();
				}
			}

			changed has-hover => {
				if self.has-hover {
					root.hovered();
				}
			}
		}
	}

	// Slint は複数状態が成立したとき「先に書いた状態」を優先する。開いている
	// ときは hover や押下よりも開状態の色を優先したいので menu_active を
	// has-hover より前に置く (押下のフィードバックだけは最優先のまま)。
	states [
		pressed when touch-area.pressed : {
			background-layer.background: root.pressed-background;
			label.color: root.pressed-foreground;
		}
		menu_active when root.menu-open : {
			background-layer.background: root.open-background;
			label.color: root.hover-foreground;
		}
		has-hover when touch-area.has-hover : {
			background-layer.background: root.hover-background;
			label.color: root.hover-foreground;
		}
	]
}

export component MenuBarBase inherits Rectangle {
	in property <length> spacing <=> layout.spacing;
	in property <LayoutAlignment> alignment <=> layout.alignment;
	in property <length> min-layout-height;
	in property <length> horizontal-padding;

	min-height: max(root.min-layout-height, layout.min-height);

	layout := HorizontalLayout {
		alignment: start;
		padding-left: root.horizontal-padding;
		padding-right: root.horizontal-padding;

		@children
	}
}

export component MenuFrameBase inherits Rectangle {
	in property <length> spacing <=> layout.spacing;
	in property <length> layout-min-width;
	in property <length> margin;

	clip: true;
	min-width: max(root.layout-min-width, layout.min-width);

	// Modification: expose the size the layout wants so the frame can be used
	// as a normal in-window overlay instead of a runtime popup window.
	out property <length> content-width: layout.preferred-width;
	out property <length> content-height: layout.preferred-height;

	// ポップアップの余白 (margin/padding) や区切り行のクリックをここで吸収
	// する。吸収しないと下の「どこかをクリックしたら閉じる」背景に届き、
	// 項目以外を押しただけでポップアップが閉じてしまう。レイアウト (項目)
	// より先に宣言するため項目のクリックは各 TouchArea が受け取る。
	TouchArea {
		width: 100%;
		height: 100%;
	}

	layout := VerticalLayout {
		padding: root.margin;
		@children
	}
}

export component MenuItemBase {
	in property <brush> default-foreground;
	in property <brush> alternate-foreground: default-foreground;
	in property <brush> default-background;
	in property <brush> current-foreground;
	in property <brush> current-background;
	in property <brush> separator-color;
	in property <length> font-size <=> label.font-size;
	in property <length> border-radius <=> background-layer.border-radius;
	// Modification: Windows-style access key shown as "(X)"; the letter is
	// underlined while `access-key-underline` is set (Alt held).
	in property <string> access-key: "";
	in property <bool> access-key-underline: false;
	// タイトル末尾の "..." を括弧閉じの後ろに回すためのフラグ。
	in property <bool> ellipsis: false;
	// Modification: explicit shortcut text shown right-aligned in the item
	// (e.g. "Ctrl+Z"); when empty, falls back to the MenuEntry shortcut.
	in property <string> shortcut-text: "";
	in property <bool> is-current;
	// Time at which the item was created, used to suppress accidental
	// activation from the mouse-up that opened the menu.
	property <duration> open-time;
	property <bool> had-press;
	init => { open-time = animation-tick(); }
	in property <MenuEntry> entry;
	in property <image> sub-menu-icon;
	in property <length> spacing <=> layout.spacing;
	in property <length> icon-size;
	in property <length> horizontal-padding;
	in property <length> vertical-padding;

	callback set-current();
	callback clear-current();
	callback activate(entry : MenuEntry, y: length);

	background-layer := Rectangle {
		background: root.default-background;

		// TouchArea は無効項目 / 区切りでも常に有効。押された入力をここで
		// 吸収しないと下のレイヤ (「どこかをクリックしたら閉じる」背景) に
		// 到達してポップアップが閉じてしまい、押されたと勘違いされる。
		// 吸収はするが反応はしない (ハイライト / 押下表示 / activate は
		// enabled かつ区切りでない場合のみ)。
		touch-area := TouchArea {
			layout := HorizontalLayout {
				padding-top: root.vertical-padding;
				padding-bottom: root.vertical-padding;
				padding-left: root.horizontal-padding;
				padding-right: root.horizontal-padding;

				spacing: 10px;

				Rectangle {
					width: root.icon-size;
					y: (parent.height - self.height) / 2;

					if entry.checked: Text {
						text: "✓";
					}

				Image {
					source: entry.icon;
					accessible-role: none;
					image-fit: contain;
					width: 100%;
					height: root.icon-size;
				}
				}

				label := AccessKeyLabel {
					text: root.entry.title;
					access-key: root.access-key;
					underline: root.access-key-underline;
					ellipsis: root.ellipsis;
					color: root.default-foreground;
					// ラベルが余白を吸収し、ショートカット表示を右端へ寄せる。
					horizontal-stretch: 1;
				}

				shortcut := Text {
					text: root.shortcut-text != "" ? root.shortcut-text : entry.shortcut.to-string();
					color: root.alternate-foreground;
					vertical-alignment: center;
					horizontal-alignment: TextHorizontalAlignment.right;
				}

				if entry.has-sub-menu : Image {
					width: root.icon-size;
					y: (parent.height - self.height) / 2;
					source: root.sub-menu-icon;
					colorize: label.color;
					accessible-role: none;
				}
			}

			pointer-event(event) => {
				if event.kind == PointerEventKind.move && entry.enabled && !entry.is-separator && !root.is-current {
					root.set-current()
				} else if event.kind == PointerEventKind.down && entry.has-sub-menu && entry.enabled {
					activate(entry, self.absolute-position.y);
				} else if event.kind == PointerEventKind.down {
					// A deliberate press always enables activation
					root.had-press = true;
				} else if event.kind == PointerEventKind.up
						&& (root.had-press || animation-tick() - root.open-time > 300ms)
						&& self.mouse-y > 0 && self.mouse-y < self.height
						&& self.mouse-x > 0 && self.mouse-x < self.width
						&& entry.enabled && !entry.is-separator {
					// can't put this in `clicked` because then the menu would close causing a panic in the pointer-event
					activate(entry, self.absolute-position.y);
				}
			}

			changed has-hover => {
				if !self.has-hover && root.is-current {
					root.clear-current();
				}
			}
		}

		if entry.is-separator: Rectangle {
			height: 1px;
			background: root.separator-color;
		}
	}

	states [
		is-current when root.is-current : {
			background-layer.background: root.current-background;
			label.color: root.current-foreground;
		}
		// 無効項目 / 区切りは hover でも set-current されないため
		// ハイライトが付かない (押されたと勘違いさせない)。クリックは
		// TouchArea が吸収し、ポップアップも閉じない。
		disabled when !entry.enabled : {
			label.opacity: 0.5;
		}
	]
}
