// ModeToggleButton
// slint標準(fluent)の button.slint のデザイン一式を移植したもの。
// 「checked(選択)状態」だけを、標準の「青(アクセント)」から「凹み」に変更する。
// ライブラリ側(i-slint-compiler/widgets/fluent/button.slint)は変更しない。
//
// 注意: 標準は checked 状態をアクセント色(青系)で塗るが、
//       ここでは選択=押し込まれた(凹んでいる)見た目にする。

import { AppTooltip } from "project-tooltip.slint";

export component ModeToggleButton inherits Rectangle {
	in property <string> text;
	// アクセラレータ (ショートカット) 文字。空なら text をそのまま描く。
	// 指定した場合は text を「前」「下線付きのアクセラレータ」「後」の3つに
	// 分けて描画し、アクセラレータの下にだけ下線を引く。
	in property <string> accent;
	in property <string> text-after;
	// マウスを重ねると出る説明。空ならツールチップを出さない。
	in property <string> tooltip-text;
	in property <image> icon;
	in property <length> icon-size: 20px;
	in property <bool> primary;
	in property <bool> enabled <=> i-touch-area.enabled;
	in property <bool> checkable;
	in property <bool> colorize-icon;
	out property <bool> has-focus: i-focus-scope.has-focus;
	out property <bool> pressed: self.enabled && i-touch-area.pressed;
	in-out property <bool> checked;

	callback clicked;

	// 選択中(== 凹み)は文字を1px沈めるが、色は標準と同じ濃さを保つ
	private property <brush> text-color: #000000E6;

	min-width: max(32px, i-layout.min-width);
	min-height: max(24px, i-layout.min-height);
	horizontal-stretch: 0;
	vertical-stretch: 0;
	forward-focus: i-focus-scope;

	accessible-role: button;
	accessible-enabled: root.enabled;
	accessible-checkable: root.checkable;
	accessible-checked: root.checked;
	accessible-label: root.accent != "" ? root.text + root.accent + root.text-after : root.text;
	accessible-action-default => { i-touch-area.clicked(); }

	states [
		disabled when !root.enabled : {
			i-background.background: root.primary || root.checked ? #00000038 : #F9F9F94D;
			i-border.border-color: root.primary || root.checked ? transparent : #00000073;
			root.text-color: root.primary || root.checked ? #FFFFFF : #0000005E;
		}
		recessed when root.checked : {
			i-background.background: #EDEDED;
			i-border.border-color: #00000033;
			i-sunken-top.background: #0000002E;
			i-layout.y: 1px;
		}
		pressed when root.pressed && !root.checked : {
			i-background.background: root.primary ? #005FB8B3 : #F9F9F94D;
			i-border.border-color: #00000073;
			root.text-color: root.primary ? #FFFFFFB3 : #00000099;
		}
		hover when i-touch-area.has-hover && !root.checked : {
			i-background.background: root.primary ? #005FB8E6 : #F9F9F980;
		}
	]

	i-background := Rectangle {
		border-radius: 4px;
		background: root.primary ? #005FB8 : #FFFFFFB3;

		animate background, border-color { duration: 150ms; }

		i-border := Rectangle {
			border-radius: parent.border-radius;
			border-width: 1px;
			border-color: root.primary ? @linear-gradient(180deg, #FFFFFF14 90.67%, #00000066 100%) : @linear-gradient(180deg, #0000000F 90.58%, #00000029 100%);
		}

		i-sunken-top := Rectangle {
			x: 1px;
			y: 1px;
			width: parent.width - 2px;
			height: 1px;
			background: transparent;
		}

		i-sunken-bottom := Rectangle {
			x: 1px;
			y: parent.height - 2px;
			width: parent.width - 2px;
			height: 1px;
			background: transparent;
		}

		i-layout := HorizontalLayout {
			padding-left: 12px;
			padding-right: 12px;
			padding-top: 4px;
			padding-bottom: 2px;
			spacing: 4px;
			alignment: center;

			if (root.icon.width > 0 && root.icon.height > 0) : Image {
				y: (parent.height - self.height) / 2;
				source <=> root.icon;
				width: root.icon-size;
				min-height: root.icon-size;
				colorize: root.colorize-icon ? root.text-color : transparent;
			}

			if (root.text != "" && root.accent == ""): Text {
				font-size: 1.0909rem;
				font-weight: FontWeight.normal;
				horizontal-alignment: center;
				vertical-alignment: center;
				text: root.text;
				color: root.text-color;
				animate color { duration: 150ms; }
				accessible-role: none;
			}

			// アクセラレータ文字だけ下線を引く。文字は1つの Text で描き
			// (分割すると CJK と Latin の行送りがずれるため)、下線だけを
			// 接頭辞の幅ぶんずらして重ねる。幅は透明の Text で測る。
			if (root.accent != ""): Rectangle {
				width: label.preferred-width;
				height: label.preferred-height;

				label := Text {
					width: parent.width;
					height: parent.height;
					font-size: 1.0909rem;
					font-weight: FontWeight.normal;
					horizontal-alignment: center;
					vertical-alignment: center;
					text: root.text + root.accent + root.text-after;
					color: root.text-color;
					animate color { duration: 150ms; }
					accessible-role: none;
				}

				Rectangle {
					x: prefix-metrics.preferred-width;
					// 下線は文字ボックスの下端ではなくベースライン直下に置く
					// (preferred-height はフォントにより行間を含み下がり過ぎる)。
					y: label.y + label.font-metrics.ascent + 1px;
					width: accent-metrics.preferred-width;
					height: 1px;
					background: root.text-color;
					animate background { duration: 150ms; }
				}

				prefix-metrics := Text {
					opacity: 0;
					text: root.text;
					font-size: 1.0909rem;
					font-weight: FontWeight.normal;
				}
				accent-metrics := Text {
					opacity: 0;
					text: root.accent;
					font-size: 1.0909rem;
					font-weight: FontWeight.normal;
				}
			}
		}
	}

	i-touch-area := TouchArea {
		clicked => {
			if (root.checkable) {
				root.checked = !root.checked;
			}
			root.clicked();
		}
	}

	i-focus-scope := FocusScope {
		x: 0;
		width: 0; // Do not react on clicks
		enabled <=> root.enabled;

		key-pressed(event) => {
			if (event.text == " " || event.text == "\n") {
				i-touch-area.clicked();
				return accept;
			}

			return reject;
		}
	}

	// focus border (standard FocusBorder 相当)
	if (root.has-focus && root.enabled) : Rectangle {
		border-radius: i-background.border-radius;
		border-width: 2px;
		border-color: #000000E6;

		Rectangle {
			x: parent.border-width;
			y: parent.border-width;
			width: parent.width - 2 * parent.border-width;
			height: parent.height - 2 * parent.border-width;
			border-width: 1px;
			border-radius: parent.border-radius - 2px;
			border-color: #FFFFFF;
		}
	}

	// マウスを重ねると、ポインタの近くに説明を表示する (空なら出さない)。
	if root.tooltip-text != "" : Tooltip {
		AppTooltip {
			text: root.tooltip-text;
		}
	}
}