// SpinBox
// slint 讓呎ｺ・(fluent) 縺ｮ spinbox.slint + common/spinbox-base.slint 繧偵い繝励Μ
// 蜀・↓遘ｻ讀阪＠縺溘ｂ縺ｮ (SmallButton / ModeToggleButton 縺ｨ蜷後§譁ｹ蠑・縲・luentPalette
// / Icons 縺ｮ萓晏ｭ倥ｒ螟悶☆縺溘ａ縲√Λ繧､繝磯・濶ｲ縺ｮ蛟､縺ｨ chevron 繧｢繧､繧ｳ繝ｳ (ui/ 驟堺ｸ九・
// _chevron-*.svg) 繧偵Ο繝ｼ繧ｫ繝ｫ蜿ら・縺ｫ鄂ｮ縺肴鋤縺医※縺・ｋ縲・
//
// 讓呎ｺ悶°繧峨・螟画峩轤ｹ: min-width 繧・128px 縺九ｉ邵ｮ蟆上＠ (140px 蟷・・繧ｵ繧､繝峨ヰ繝ｼ縺ｸ
// 蜿弱ａ繧・縲∫泙蜊ｰ繝懊ち繝ｳ縺ｨ菴咏區繧らｸｮ繧√◆縲らｸｦ繧よｽｰ縺励※ (min-height 20px繝ｻ譁・ｭ・
// 11px) 繧ｵ繧､繝峨ヰ繝ｼ縺ｮ縺ｻ縺九・陦後→蜷後§縺上ｉ縺・・鬮倥＆縺ｫ縺励◆縲・
// 繝ｩ繧､繝悶Λ繝ｪ蛛ｴ (i-slint-compiler/widgets/fluent/*) 縺ｯ螟画峩縺励↑縺・・


import { AppTooltip } from "project-tooltip.slint";
export component SpinBoxBase {
	in property <int> minimum;
	in property <int> maximum: 100;
	in property <bool> enabled: true;
	in property <brush> color <=> text-input.color;
	in property <length> font-size <=> text-input.font-size;
	in property <int> font-weight <=> text-input.font-weight;
	in property <color> selection-background-color <=> text-input.selection-background-color;
	in property <color> selection-foreground-color <=> text-input.selection-foreground-color;
	in property <TextHorizontalAlignment> horizontal-alignment <=> text-input.horizontal-alignment;
	in property <int> step-size: 1;
	in property <bool> read-only;
	out property <bool> has-focus <=> text-input.has-focus;
	in-out property <int> value: minimum;

	callback edited(value: int);

	public function update-value(value: int) {
		if root.value == value || (value >= root.minimum && value <= root.maximum) {
			root.value = value;
			root.edited(value);
		}
	}

	public function increment() {
		if !root.read-only {
			root.update-value(root.value + root.step-size);
		}
	}

	public function decrement() {
		if !root.read-only {
			root.update-value(root.value - root.step-size);
		}
	}

	private property <length> scroll-delta: 2px;

	forward-focus: text-input;

	changed value => {
		root.set-text-to-value();
	}

	function set-text-to-value() {
		text-input.text = root.value;
	}

	i-touch-area := TouchArea {
		enabled: root.enabled && !root.read-only;

		scroll-event(event) => {
			if event.delta-y > 0 {
				root.increment();
				return accept;
			}

			if event.delta-y < 0 {
				root.decrement();
				return accept;
			}

			reject
		}
	}

	text-input := TextInput {
		vertical-alignment: center;
		horizontal-alignment: left;
		text: root.value;
		enabled: root.enabled;
		read-only: root.read-only;
		width: 100%;
		height: 100%;

		accessible-role: none;

		accepted => {
			if !self.text.is-float() {
				root.set-text-to-value();
			}
		}

		edited => {
			if self.text.is-float() && self.text.to-float() != root.value {
				root.update-value(self.text.to-float());
			} else if !self.text.is-float() && self.text != "" {
				root.set-text-to-value();
			}
		}
	}
}

export component SpinBoxButton {
	callback clicked <=> touch-area.clicked;

	in property <image> icon <=> icon.source;

	min-width: 20px;
	horizontal-stretch: 0;

	states [
		pressed when touch-area.pressed : {
			background.background: #0000000A;
		}
	]

	background := Rectangle {
		border-radius: 3px;

		icon := Image {
			image-fit: contain;
			colorize: #00000099;
			width: 12px;
			// height 繧呈・遉ｺ縺励↑縺・→ SVG 縺ｮ螳溷ｯｸ蝓ｺ貅悶〒邂怜・縺輔ｌ縲｜utton 縺・
			// 蠢・ｦ∽ｻ･荳翫↓邵ｦ縺ｫ閹ｨ蠑ｵ縺吶ｋ (螳滓ｸｬ ~66px)縲・2px 縺ｫ蝗ｺ螳壹☆繧九・
			height: 12px;
			accessible-role: none;

			animate colorize { duration: 150ms; }
		}
	}

	touch-area := TouchArea {}
}


export component SpinBox {
	in property <int> minimum <=> base.minimum;
	in property <int> maximum <=> base.maximum;
	in property <bool> enabled <=> base.enabled;
	in property <int> step-size <=> base.step-size;
	in property <bool> read-only <=> base.read-only;
	in property <TextHorizontalAlignment> horizontal-alignment <=> base.horizontal-alignment;
	// 繝槭え繧ｹ繧帝㍾縺ｭ繧九→蜃ｺ繧玖ｪｬ譏弱らｩｺ縺ｪ繧峨ヤ繝ｼ繝ｫ繝√ャ繝励ｒ蜃ｺ縺輔↑縺・・
	in property <string> tooltip-text;
	out property <bool> has-focus <=> base.has-focus;
	in-out property <int> value <=> base.value;

	callback edited <=> base.edited;

	// 128px -> 繧ｵ繧､繝峨ヰ繝ｼ逕ｨ縺ｫ邵ｮ蟆・(遏｢蜊ｰ繝懊ち繝ｳ繝ｻ菴咏區繧ゆｻ･荳九〒邵ｮ蟆・縲・
	min-width: max(64px, layout.min-width);
	min-height: max(20px, layout.min-height);
	vertical-stretch: 0;
	horizontal-stretch: 1;
	forward-focus: base;

	accessible-role: spinbox;
	accessible-enabled: root.enabled;
	accessible-value: root.value;
	accessible-value-minimum: root.minimum;
	accessible-value-maximum: root.maximum;
	accessible-value-step: (root.maximum - root.minimum) / 100;
	accessible-action-set-value(v) => { if v.is-float() { base.update-value(v.to-float()); } }
	accessible-action-increment => { base.increment(); }
	accessible-action-decrement => { base.decrement(); }
	accessible-read-only: root.read-only;

	states [
		disabled when !root.enabled : {
			background.background: #F9F9F94D;
			background.border-color: #00000073;
			base.color: #0000005E;
			base.selection-foreground-color: #FFFFFF;
		}
		focused when root.has-focus : {
			background.background: #FFFFFF;
			focus-border.background: #005FB8;
		}
	]

	background := Rectangle {
		border-radius: 4px;
		background: #FFFFFFB3;
		border-width: 1px;
		border-color: @linear-gradient(180deg, #0000000F 99.99%, #00000073 100%, #00000073 100%);

		layout := HorizontalLayout {
			padding-left: 8px;
			padding-right: 2px;
			padding-top: 2px;
			padding-bottom: 2px;
			spacing: 2px;

			Rectangle {
				clip: true;
				horizontal-stretch: 1;

				base := SpinBoxBase {
					width: 100%;
					// 繧ｵ繧､繝峨ヰ繝ｼ逕ｨ縺ｫ譁・ｭ励ｒ 11px 縺ｫ縺励※邵ｦ繧定ｩｰ繧√ｋ縲・
					font-size: 1rem;
					color: #000000E6;
					selection-background-color: #0078D4;
					selection-foreground-color: #FFFFFF;
				}
			}

			SpinBoxButton {
				visible: root.enabled && !root.read-only;
				icon: @image-url("_chevron-up.svg");

				clicked => {
					base.increment();
				}
			}

			SpinBoxButton {
				visible: root.enabled && !root.read-only;
				icon: @image-url("_chevron-down.svg");

				clicked => {
					base.decrement();
				}
			}
		}

		focus-border := Rectangle {
			x: parent.border-radius;
			y: parent.height - self.height;
			width: parent.width - 2 * parent.border-radius;
			height: 2px;
		}

		if root.tooltip-text != "" : Tooltip {
			AppTooltip {
				text: root.tooltip-text;
			}
		}
	}
}

