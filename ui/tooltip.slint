// カーソル追従ツールチップ (コントロール用)。
//
// slint 標準の組み込み Tooltip 要素の代わりに使う。標準の配置は「ポインタの
// 右下に出し、ウィンドウからはみ出すときは左 / 上にずらして収める (クラン
// プ)」だが、これは表示位置を決めるのがコンパイラの内製機構 (lower_tooltips)
// でアプリから変えられない。そこで表示を自前で行い、配置を変えている:
//
// 「ポインタの位置を基準に、パネルの四つ角のいずれかをポインタに合わせる」。
// 既定は右下 (ポインタ = パネルの左上角)。右 / 下にはみ出すなら、左 / 上へ
// 出して (ポインタ = 反対側の角) はみ出しを避ける。左右または上下のどちらに
// 置いてもはみ出す場合だけ例外で、ウィンドウ内に収める (クランプ)。標準の
// 8px の隙間はなく、ポインタが角に密着する。
//
// 配置の計算は Rust 側 (SharedGlobals::new が TooltipHub.place へ配線) で
// 行う。.slint の位置バインディングに条件式を書かず、表示レイヤの width /
// height も百分率にしないのは意図的: 実測のとおり、(a) 子要素のバインディ
// ングの三項演算子 (Condition)、(b) ルートの width: 100% の 2 つが揃うとコ
// ンパイラの default_geometry がルートの幅の解決に失敗する (「Cannot find
// parent property to apply relative length」)。百分率の代わりにウィンドウ
// サイズを Rust から実地で読んで win-width / win-height へ流し込む。
//
// 構成は MenuHintHub / MenuHintPopup と同じハブ方式:
// - TooltipSensor: コントロールの全面を包むホバー センサ (各コントロールが
//   使う)。遅延後に TooltipHub へ報告する
// - TooltipHub: 表示中のツールチップ (1 件) と配置結果。from_library の
//   グローバルはルート コンポーネント (= ウィンドウ) ごとの実体なので、
//   複数ウィンドウでも互いに混線しない
// - TooltipPopup: 表示レイヤ。アプリのウィンドウ ルートの最後に置く
//   (MenuHintPopup と同じ)。TouchArea を持たない透明レイヤなので、クリック
//   は下のコントロールへ素通しする
//
// place は SharedGlobals::new がウィンドウごとに配線するため、アプリ側に
// 必要なコードは無い。

// 表示中のツールチップ。実体はウィンドウごと (from_library)。
export global TooltipHub {
	// 表示する説明。空 = 非表示。
	in-out property <string> text: "";
	// 報告元カーソルのウィンドウ座標 (センサが書く)。
	in-out property <length> cursor-x: 0px;
	in-out property <length> cursor-y: 0px;
	// パネルのサイズ (表示レイヤが書く。配置計算の材料)。
	in-out property <length> panel-w: 0px;
	in-out property <length> panel-h: 0px;
	// 配置結果 (Rust の place が書く。表示レイヤが読む)。
	in-out property <length> panel-x: 0px;
	in-out property <length> panel-y: 0px;
	// ウィンドウのサイズ (Rust の place が書く。表示レイヤのルート サイズ)。
	in-out property <length> win-width: 0px;
	in-out property <length> win-height: 0px;
	// place が配線済みか (未配線なら表示しない)。
	in-out property <bool> active: false;
	// 切り分け用ログ (SLINT_TOOLTIP_DEBUG=1 で Rust 側から有効化)。
	in-out property <bool> debug-log: false;

	// 配置を依頼する (センサから。Rust 側で計算して panel-x / panel-y へ書く)。
	callback place(cursor-x: length, cursor-y: length, panel-w: length, panel-h: length);
}

// コントロール全面のホバー センサ。中身 (@children) を包んで使う。
//
// TouchArea は移動イベントを取得 (EventAccepted) するため、兄弟として重ねた
// のでは下の TouchArea に hover が届かない。そこで**祖先として**包む: マウス
// ルーティングは祖先のフィルタ段 (input_event_filter_before_children) を子よ
// り先に必ず通すので、子 (ボタン本体の TouchArea や TextInput) がイベントを
// 取っても、このセンサの has-hover / mouse-x / mouse-y は常に更新される。
// クリック処理は持たない (子に任せる)。無効なコントロールの上でも hover を
// 取れるよう、このセンサ自身は常に有効 (子が無効の間は子が押下を無視するだ
// けで、センサが押下を握る点は標準 Tooltip と異なる)。
export component TooltipSensor inherits TouchArea {
	// マウスを重ねると出る説明。空なら何もしない。
	in property <string> tooltip-text;
	// 表示を開始したか (Timer の再発火防止と位置追従のゲート)。
	private property <bool> shown: false;

	// カーソルのウィンドウ座標 (absolute-position はウィンドウ基準)。
	private property <length> cursor-x: self.absolute-position.x + self.mouse-x;
	private property <length> cursor-y: self.absolute-position.y + self.mouse-y;

	Timer {
		// 標準 Tooltip の既定遅延と同じ 500ms。
		interval: 500ms;
		running: root.has-hover && !root.shown && root.tooltip-text != "";
		triggered => {
			if (TooltipHub.debug-log) {
				debug("tooltip: タイマー発火");
			}
			root.shown = true;
			TooltipHub.cursor-x = root.cursor-x;
			TooltipHub.cursor-y = root.cursor-y;
			TooltipHub.text = root.tooltip-text;
			TooltipHub.place(TooltipHub.cursor-x, TooltipHub.cursor-y, TooltipHub.panel-w, TooltipHub.panel-h);
		}
	}

	changed has-hover => {
		if (TooltipHub.debug-log) {
			debug("tooltip: hover 変化");
		}
		if (!self.has-hover) {
			root.shown = false;
			// 自分の報告がまだ表示中のときだけ消す (隣のコントロールへ hover
			// が移った場合、移動先の報告を消さないため)。
			if (TooltipHub.text == root.tooltip-text) {
				TooltipHub.text = "";
			}
		}
	}

	@children
}

// ツールチップの表示レイヤ。**ウィンドウのルートの最後に置く** (MenuHintPopup
// と同じ)。TouchArea を持たない透明レイヤなので、表示中もクリックは下の
// コントロールへ素通しする。ルートのサイズは百分率にせず、Rust が流し込む
// ウィンドウ サイズ (win-width / win-height) に束縛する (実測: 百分率を条件
// 式つきの子バインディングと組み合わせるとルートの解決が壊れるため)。
// パネルの座標はウィンドウ座標そのまま (レイヤはウィンドウの (0,0) に置かれ
// るため)。表示位置は「表示開始時のカーソル位置」で確定し、以後は追従しない
// (サイズが確定した時点での再配置のみ。位置の再計算はカーソル追従を意味し
// ない)。
export component TooltipPopup inherits Rectangle {
	x: 0;
	y: 0;
	width: TooltipHub.win-width;
	height: TooltipHub.win-height;
	visible: TooltipHub.active && TooltipHub.text != "";

	i-panel := Rectangle {
		x: TooltipHub.panel-x;
		y: TooltipHub.panel-y;
		width: i-text.preferred-width + 16px;
		height: i-text.preferred-height + 4px;
		background: #ffffff;
		border-radius: 3px;
		border-width: 0.5px;
		border-color: #00000040;
		drop-shadow-color: #00000033;
		drop-shadow-offset-y: 1px;
		drop-shadow-blur: 2px;

		i-text := Text {
			x: 8px;
			y: 2px;
			width: self.preferred-width;
			height: self.preferred-height;
			text: TooltipHub.text;
			color: #202020;
			font-size: 1rem;
		}

		// パネルのサイズをハブへ伝える (place の引数として使われる)。
		// ここで place を再呼び出ししないのは意図的: changed はレイアウト確定
		// のたびに (ウィンドウ表示中も) 発火し、コールバック -> ハブ書き込み
		// -> 再レイアウトの連鎖が表示中のちらつきになるため (実測)。サイズは
		// ここで伝わるので、次の place 呼び出し (ホバー開始時) から正しい値
		// が使われる。
		changed width => { TooltipHub.panel-w = self.width; }
		changed height => { TooltipHub.panel-h = self.height; }
	}
}
