// カーソル追従ツールチップ (コントロール用)。
//
// slint 標準の組み込み Tooltip 要素の代わりに使う。標準の配置は「ポインタの
// 右下に出し、ウィンドウからはみ出すときは左 / 上にずらして収める (クラン
// プ)」だが、これは表示位置を決めるのがコンパイラの内製機構 (lower_tooltips)
// でアプリから変えられない。そこで表示を自前で行い、配置を変えている:
//
// 「ポインタの位置を基準に、パネルの四つ角のいずれかをポインタに合わせる」。
// 既定は右下 (ポインタ = パネルの左上角)。右 / 下にはみ出すなら、左 / 上へ
// 出して (ポインタ = 反対側の角) はみ出しを避ける。左右または上下のどちらに
// 置いてもはみ出す場合だけ例外で、ウィンドウ内に収める (クランプ)。標準の
// 8px の隙間はなく、ポインタが角に密着する。
//
// 配置の計算は Rust 側 (SharedGlobals::new が TooltipHub.place へ配線) の
// **純粋コールバック**で行う。表示レイヤのジオメトリ バインディングから直接
// 呼び出すため、ハブへの書き込みがなく (純粋 = 副作用なし)、レイアウト中の
// コールバック -> ハブ書き込み -> 再レイアウトの連鎖 (表示中のちらつきの原
// 因) がない。パネルのサイズは place の引数として self.width / self.height
// を渡す (バインディング評価時に現在値が得られるため、テキスト確定直後でも
// 古いサイズにならない)。ウィンドウ サイズも Rust から実地で読むため、
// 百分率は使わない (百分率 + 子バインディングの条件式は default_geometry の
// ルート幅解決を壊す。実測)。
//
// 構成は MenuHintHub / MenuHintPopup と同じハブ方式:
// - TooltipSensor: コントロールの全面を包むホバー センサ (各コントロールが
//   使う)。遅延後に TooltipHub へ報告する
// - TooltipHub: 表示中のツールチップ (1 件)。from_library のグローバルは
//   ルート コンポーネント (= ウィンドウ) ごとの実体なので、複数ウィンドウ
//   でも互いに混線しない
// - TooltipPopup: 表示レイヤ。アプリのウィンドウ ルートの最後に置く
//   (MenuHintPopup と同じ)。TouchArea を持たない透明レイヤなので、クリック
//   は下のコントロールへ素通しする
//
// 表示位置は「表示開始時のカーソル位置」で確定し、以後カーソルに追従しない
// (センサはタイマー発火時に 1 回だけカーソルを報告する)。

// place の配置結果。px / py = パネルの配置座標 (ウィンドウ座標)。
export struct PanelPlacement {
	px: length,
	py: length,
}

// 表示中のツールチップ。実体はウィンドウごと (from_library)。
export global TooltipHub {
	// 表示する説明。空 = 非表示。
	in-out property <string> text: "";
	// 表示開始時のカーソルのウィンドウ座標 (センサが書く)。
	in-out property <length> cursor-x: 0px;
	in-out property <length> cursor-y: 0px;
	// place が配線済みか (未配線なら表示しない)。
	in-out property <bool> active: false;
	// ヒントの表示先モード。true (既定) = TooltipPopup (カーソル位置のポップ
	// アップ) に表示する。false = ポップアップを出さず、text をアプリのステ
	// ータス行へ任せる (アプリは text を束ね、ステータスバーの表示切替に追
	// 従してこの値を入れ替える)。ステータス行モードでは遅延なしで即時に表示
	// する (遅延はカーソル位置のポップアップが目障りであるための配慮)。
	in-out property <bool> popup-enabled: true;
	// 切り分け用ログ (SLINT_TOOLTIP_DEBUG=1 で Rust 側から有効化)。
	in-out property <bool> debug-log: false;

	// 配置を計算する (純粋: 副作用なし。表示レイヤのジオメトリ バインディン
	// グから呼ばれる。Rust 側でウィンドウ サイズを実地で読み、四つ角のいずれ
	// かにカーソルを合わせた位置を返す)。
	pure callback place(cursor-x: length, cursor-y: length, panel-w: length, panel-h: length) -> PanelPlacement;
}

// コントロール全面のホバー センサ。中身 (@children) を包んで使う。
//
// TouchArea は移動イベントを取得 (EventAccepted) するため、兄弟として重ねた
// のでは下の TouchArea に hover が届かない。そこで**祖先として**包む: マウス
// ルーティングは祖先のフィルタ段 (input_event_filter_before_children) を子よ
// り先に必ず通すので、子 (ボタン本体の TouchArea や TextInput) がイベントを
// 取っても、このセンサの has-hover / mouse-x / mouse-y は常に更新される。
// クリック処理は持たない (子に任せる)。無効なコントロールの上でも hover を
// 取れるよう、このセンサ自身は常に有効 (子が無効の間は子が押下を無視するだ
// けで、センサが押下を握る点は標準 Tooltip と異なる)。TouchArea 継承なので、
// 既存の TouchArea (ドラッグ ハンドラなど) をそのまま置き換えて使うことも
// できる。
export component TooltipSensor inherits TouchArea {
	// マウスを重ねると出る説明。空なら何もしない。
	in property <string> tooltip-text;
	// 表示を開始したか (Timer の再発火防止のゲート)。
	private property <bool> shown: false;

	// 表示開始時のカーソルのウィンドウ座標 (absolute-position はウィンドウ基準)。
	private property <length> cursor-x: self.absolute-position.x + self.mouse-x;
	private property <length> cursor-y: self.absolute-position.y + self.mouse-y;

	Timer {
		// 標準 Tooltip の既定遅延と同じ 500ms。ポップアップモードでのみ走る
		// (ステータス行モードは changed has-hover で即時に出す)。
		interval: 500ms;
		running: TooltipHub.popup-enabled && root.has-hover && !root.shown && root.tooltip-text != "";
		triggered => {
			// (デバッグコード・コメントアウト) タイマー発火の確認用。使うと
			// きはコメントを外す (TooltipHub.debug-log を SLINT_TOOLTIP_DEBUG=1
			// で有効化してから)。
			// if (TooltipHub.debug-log) {
			// 	debug("tooltip: タイマー発火");
			// }
			root.shown = true;
			TooltipHub.cursor-x = root.cursor-x;
			TooltipHub.cursor-y = root.cursor-y;
			TooltipHub.text = root.tooltip-text;
		}
	}

	changed has-hover => {
		// (デバッグコード・コメントアウト) hover 変化の確認用。使うときはコ
		// メントを外す (TooltipHub.debug-log を SLINT_TOOLTIP_DEBUG=1 で有効
		// 化してから)。
		// if (TooltipHub.debug-log) {
		// 	debug("tooltip: hover 変化");
		// }
		if (self.has-hover) {
			// ステータス行モード: 遅延なしで即時にヒントを出す (ポップアップ
			// は出ない。ステータス行は目障りでないため遅延が不要)。
			if (!TooltipHub.popup-enabled && root.tooltip-text != "") {
				TooltipHub.text = root.tooltip-text;
				root.shown = true;
			}
		} else {
			root.shown = false;
			// 自分の報告がまだ表示中のときだけ消す (隣のコントロールへ hover
			// が移った場合、移動先の報告を消さないため)。
			if (TooltipHub.text == root.tooltip-text) {
				TooltipHub.text = "";
			}
		}
	}

	@children
}

// ツールチップの表示レイヤ。**ウィンドウのルートの最後に置く** (MenuHintPopup
// と同じ)。TouchArea を持たない透明レイヤなので、表示中もクリックは下の
// コントロールへ素通しする。
//
// ルートのサイズは**固定值** (min-width / min-height は 0 に明示)。理由:
// (1) 百分率やハブ経由のウィンドウ サイズ束縛は、ウィンドウの最小サイズ ヒ
// ント (WM_NORMAL_HINTS) を表示後に変化させ、WM が再配置する = ちらつきの
// 原因になっていた (実測)。固定值 + min 0 ならヒントが変化しない。(2) レイ
// ヤはクリップしないため、子 (パネル) はルートの外側にも描画できる (サイ
// ズは描画の要件ではない)。
// パネルの座標はウィンドウ座標そのまま (レイヤはウィンドウの (0,0) に置かれ
// るため)。表示位置は「表示開始時のカーソル位置」で確定し、以後カーソルに追
// 従しない。
export component TooltipPopup inherits Rectangle {
	x: 0;
	y: 0;
	width: 800px;
	height: 600px;
	min-width: 0px;
	min-height: 0px;
	visible: TooltipHub.active && TooltipHub.popup-enabled && TooltipHub.text != "";

	i-panel := Rectangle {
		x: TooltipHub.place(TooltipHub.cursor-x, TooltipHub.cursor-y, self.width, self.height).px;
		y: TooltipHub.place(TooltipHub.cursor-x, TooltipHub.cursor-y, self.width, self.height).py;
		width: i-text.preferred-width + 16px;
		height: i-text.preferred-height + 4px;
		// 表示ゲート: パネル幅の安定検出 (フォント計測が数フレームかけて段階
		// 的に確定するため。実測: 0 -> 19 -> 147 など)。確定中のパネルを表示
		// すると「出現 -> 反転再計算 -> 位置が動く」ちらつきになるため、幅が
		// 1 フレーム以上変化しなければ表示しない。幅は表示タイマー (フレーム
		// 每) で 1 フレーム遅延して追跡する (prev-w / stable-w)。ハードコード
		// した待ち時間は不要 (計測の確定フレーム数に自動追従)。
		visible: self.width > 0px && self.width == root.stable-w;
		background: #ffffff;
		border-radius: 3px;
		border-width: 0.5px;
		border-color: #00000040;
		drop-shadow-color: #00000033;
		drop-shadow-offset-y: 1px;
		drop-shadow-blur: 2px;

		i-text := Text {
			x: 8px;
			y: 2px;
			width: self.preferred-width;
			height: self.preferred-height;
			text: TooltipHub.text;
			color: #202020;
			font-size: 1rem;
		}
	}

	// 幅の安定検出: 幅を 1 フレーム遅延で追跡する (prev-w = 前フレームの幅、
	// stable-w = 安定したとみなす幅)。表示ゲートは「現在の幅 == stable-w」。
	private property <length> prev-w: 0px;
	private property <length> stable-w: 0px;

	Timer {
		// フレーム每に幅を 1 フレーム遅延で追跡する。
		interval: 16ms;
		running: TooltipHub.text != "";
		triggered => {
			root.stable-w = root.prev-w;
			root.prev-w = i-panel.width;
		}
	}
}
