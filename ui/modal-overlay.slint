// モーダルのオーバーレイ表示面 (InWindowOverlay 方式)。
//
// アプリの MainWindow は ModalPopupHost を 1 つ置き、中身 (@children) に
// ModalDialogHost で包んだダイアログの画面を置す。表示の切替は
// ModalOverlayHub.open-key への書き込みだけで行われ (ModalController が
// 書く)、アプリ側に方式ごとの分岐は現れない。

// 表示中のダイアログの key (0 = どのポップアップも非表示)。
// ModalController (Rust) が書き、ModalPopupHost / ModalDialogHost が読む。
export global ModalOverlayHub {
	in-out property <int> open-key: 0;
}

// アプリの MainWindow に 1 つ置くポップアップの土台。@children に
// ModalDialogHost で包んだダイアログの画面を置す。open-key != 0 のとき
// 背景を暗転し、ダイアログの外の操作を止める。
export component ModalPopupHost {
	// 背景の暗転 (ダイアログの外の操作を止める)。
	if ModalOverlayHub.open-key != 0 : Rectangle {
		width: 100%;
		height: 100%;
		background: #00000066;
		TouchArea { width: 100%; height: 100%; }
	}

	// ダイアログの画面 (各自が open-key で自己表示し、自分で中央に置く)。
	Rectangle {
		width: 100%;
		height: 100%;

		@children
	}
}

// ダイアログの画面を包む。open-key が自分の dialog-key と一致するときだけ
// 中央のパネルとして表示する (非表示の間は描画も入力もない)。
export component ModalDialogHost {
	// このダイアログの key (ModalOverlayHub.open-key と比較する)。
	in property <int> dialog-key;
	// パネルの見出し (空欄なら出さない)。
	in property <string> title;
	// パネルの幅。
	in property <length> panel-width: 380px;
	// パネル内の行間。
	in property <length> content-spacing: 8px;

	width: 100%;
	height: 100%;
	visible: ModalOverlayHub.open-key == root.dialog-key;

	// デバッグ/診断用: パネルとホストの実高さ。
	out property <length> panel-height: panel.height;
	out property <length> host-height: self.height;

	HorizontalLayout {
		alignment: center;

		VerticalLayout {
			alignment: center;

			panel := Rectangle {
				width: root.panel-width;
				background: #f7f7f7;
				border-radius: 4px;
				border-width: 1px;
				border-color: #cccccc;
				drop-shadow-blur: 8px;
				drop-shadow-color: #00000040;
				drop-shadow-offset-x: 0px;
				drop-shadow-offset-y: 2px;

				VerticalLayout {
					padding: 12px;
					spacing: root.content-spacing;

					if root.title != "" : Text {
						text: root.title;
						font-size: 1rem;
						font-weight: 600;
						color: #333333;
					}

					@children
				}
			}
		}
	}
}
