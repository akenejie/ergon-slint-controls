export component CommonTooltip inherits Rectangle {
	in property <string> text;
	in property <length> padding-x: 4px;
	in property <length> padding-y: 2px;

	width: t.preferred-width + 2 * root.padding-x;
	height: t.preferred-height + 2 * root.padding-y;
	background: #ffffff;
	border-color: #00000040;
	border-width: 0.5px;
	border-radius: 3px;
	drop-shadow-color: #00000033;
	drop-shadow-offset-y: 1px;
	drop-shadow-blur: 2px;
	z: 2000;

	t := Text {
		x: root.padding-x;
		y: root.padding-y;
		width: self.preferred-width;
		height: self.preferred-height;
		text: root.text;
		font-size: 1rem;
		color: #202020;
		vertical-alignment: center;
	}
}
export component SmartTooltip {
	in property <string> text;
	in property <length> mouse-x;
	in property <length> mouse-y;
	in property <length> host-width;
	in property <length> host-height;
	in property <bool> visible;

	if visible && text != "" : tt := Rectangle {
		// try to place at right-bottom; if overflows, try other corners
		property <length> tw: t.preferred-width + 8px;
		property <length> th: t.preferred-height + 4px;
		x: mouse-x + 4px;
		y: mouse-y + 4px;
		// adjust if would overflow
		states [
			rb when (mouse-x + 4px + tw <= host-width || mouse-x + 4px <= host-width - tw ? false : false) : {} // simple
		]
		// simpler: compute
		width: tw;
		height: th;
		background: #ffffff;
		border-color: #00000040;
		border-width: 0.5px;
		border-radius: 3px;
		drop-shadow-color: #00000033;
		drop-shadow-offset-y: 1px;
		drop-shadow-blur: 2px;
		z: 2000;

		t := Text {
			x: 4px;
			y: 2px;
			width: self.preferred-width;
			height: self.preferred-height;
			text: root.text;
			font-size: 1rem;
			color: #202020;
			vertical-alignment: center;
		}
	}
}
